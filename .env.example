# ============ Peezy (api.p0.systems) ============
PEEZY_API_BASE="https://api.p0.systems"
PEEZY_SITE_ORIGIN="https://peezy.p0.systems"
PEEZY_CONNECT_PATH="/connect"
# OpenAI 兼容上游地址（会写入 sub2api 账号的 base_url）
PEEZY_UPSTREAM_BASE_URL="https://api.p0.systems/api/agents/v1"
# 默认模型列表（JSON 数组），会写入 sub2api 账号的 model_mapping
PEEZY_MODELS=["kimi-k3","grok-4.5"]
PEEZY_PASSWORD_LENGTH="14"
# hCaptcha sitekey（程序会先请求 /auth/config 动态获取，这里是兜底）
PEEZY_HCAPTCHA_SITEKEY="23743efe-d960-43b0-ab62-6db42b767966"
PEEZY_TIMEOUT="30"
# 单个账号注册失败后换新邮箱重试次数
PEEZY_REGISTER_RETRIES="3"

# ============ 运行参数（CLI 与 WebUI 共用） ============
# 注册并发线程数（WebUI 设置页可改）
REGISTER_WORKERS="1"
# 是否直连（绕过系统/环境代理；本机 Clash 不稳时可设 true）
DIRECT="false"
# 强制代理，如 http://127.0.0.1:7897（留空用系统代理）
PROXY=""
# 默认注册数量 / 默认模式 / 登录账号文件 / 结果文件
REGISTER_COUNT="1"
REGISTER_MODE="register"
ACCOUNT_FILE="accounts_to_login.txt"
OUTPUT_FILE="accounts.json"

# ============ CaptchaRun 打码 ============
CAPTCHA_RUN_API_BASE="https://api.captcha.run"
# 你的 CaptchaRun 令牌（后台「用户信息」页，自行填写）
# 没有账号？点此注册（邀请）：https://captcha-run.com/sso?inviter=ce5f1e67-e364-40b9-9593-6be2f36d2108
CAPTCHA_RUN_TOKEN=""
CAPTCHA_USE_CACHE="true"
CAPTCHA_POLL_INTERVAL="5"
CAPTCHA_MAX_WAIT="180"

# ============ 临时邮箱（自行填写，例如 https://apimail.你的域名.top） ============
MAIL_API_BASE=""
MAIL_PATH_ADDRESS="/api/new_address"
MAIL_PATH_MESSAGES="/api/mails"
# 收信域名，多个用逗号分隔，自动轮换（留空则由 Worker 决定）
MAIL_DOMAINS=""
MAIL_NAME_LENGTH="10"
MAIL_TIMEOUT="20"

# ============ sub2api 推送 ============
SUB2API_AUTO_PUSH="true"
# 管理 API 基础地址（不带 /api/v1，自行填写）
SUB2API_API_BASE=""
# 后台生成的 Admin API Key
SUB2API_API_KEY=""
SUB2API_AUTH_HEADER="x-api-key"
SUB2API_AUTH_PREFIX=""
SUB2API_PLATFORM="openai"
SUB2API_TYPE="apikey"
# 目标分组：优先 group_id；留空则按 group_name 查找，找不到自动创建
SUB2API_GROUP_ID=""
SUB2API_GROUP_NAME=""
SUB2API_CONCURRENCY="1"
SUB2API_PRIORITY="0"
SUB2API_RATE_MULTIPLIER="1"
# 可选：自定义模型映射 JSON（默认 PEEZY_MODELS 原样映射 + auto->auto）
SUB2API_MODEL_MAPPING=""
SUB2API_TIMEOUT="30"
